{
  "expo": {
    "name": "Familia Cerca",
    "slug": "familia-cerca-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familiacerca.app"
    },
    "android": {
      "package": "com.familiacerca.app",
      "permissions": [
        "INTERNET"
      ]
    }
  }
}
   
